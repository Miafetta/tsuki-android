<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_text_dark">#FFFFFFFF</color>
    <color name="widget_text_light">@color/miuix_widget_on_surface_light</color>
    <!-- Official Skland Arknights widget dark tone (base behind widget_arknights_bg_dark.webp). -->
    <color name="widget_background_dark">#FF323232</color>
    <color name="widget_background_light">@color/miuix_widget_surface_light</color>
    <color name="widget_secondary_dark">#B2FFFFFF</color>
    <color name="widget_secondary_light">@color/miuix_widget_summary_light</color>
    <color name="widget_label_dark">#CCFFFFFF</color>
    <color name="widget_label_light">@color/miuix_widget_summary_light</color>
    <!-- Official Skland Arknights accent blue (sk_game_arknights): refresh and dark summary counts. -->
    <color name="widget_accent_dark">#FF22BBFF</color>
    <!-- Day light widgets keep the Miuix primary for refresh. -->
    <color name="widget_accent_light">@color/miuix_widget_primary_light</color>
    <!-- Summary cells are translucent: official Skland #8C222222 on dark cards (and light widgets at night),
         letting the artwork or host blur show through while keeping high contrast. -->
    <color name="widget_cell_dark">#8C222222</color>
    <!-- Light: 60% white over the host blur material. -->
    <color name="widget_cell_light">#99FFFFFF</color>
    <!-- Extra cells (daily tasks, rest progress) share the summary cell surfaces above. -->
    <color name="widget_extra_dark">#8C222222</color>
    <color name="widget_extra_light">#99FFFFFF</color>
    <color name="widget_track_dark">#80D9D9D9</color>
    <color name="widget_track_light">@color/miuix_widget_container_light</color>
    <color name="widget_progress_dark">#FFD9D9D9</color>
    <color name="widget_progress_light">@color/miuix_widget_primary_light</color>
    <color name="widget_time_light">@color/miuix_widget_summary_light</color>
    <!-- Endfield card, aligned to the official Android Skland Endfield widget (always dark). -->
    <color name="widget_endfield_surface">#FF292929</color>
    <color name="widget_endfield_panel">#FF363636</color>
    <color name="widget_endfield_panel_rim">#33FFFFFF</color>
    <color name="widget_endfield_yellow">#FFFFF100</color>
    <color name="widget_endfield_text">#FFFFFFFF</color>
    <color name="widget_endfield_row_text">#E6FFFFFF</color>
    <color name="widget_endfield_secondary">#B2FFFFFF</color>
    <color name="widget_endfield_refresh_text">#73FFFFFF</color>
    <color name="widget_endfield_slash">#FFA7A7A7</color>
    <color name="widget_endfield_pill">#12FFFFFF</color>
    <color name="widget_endfield_dot">#FFFF7500</color>
    <color name="widget_endfield_dot_green">#FF7DCB1A</color>
    <color name="widget_endfield_divider">#14FFFFFF</color>
    <color name="widget_endfield_magenta">#FFFF00FE</color>
    <color name="widget_endfield_cyan">#FF00FFB8</color>
</resources>
