<?xml version="1.0" encoding="utf-8"?>
<!-- Always-dark counterpart of status_widget_loading_light, with the official Arknights dark artwork surface behind the
     content frame so loading matches the placed dark card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background" android:forceDarkAllowed="false"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_host_dark" android:clipChildren="false" android:clipToPadding="false"
    android:clipToOutline="true" android:contentDescription="@string/status_loading" tools:ignore="NestedWeights">
    <ImageView android:id="@+id/status_dark_surface" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_arknights_bg_dark" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/status_loading_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="10.8dp" android:baselineAligned="false">
        <LinearLayout android:id="@+id/status_header" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="19.44" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false">
            <ImageView android:id="@+id/status_avatar" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:adjustViewBounds="true" android:src="@drawable/widget_placeholder_circle_dark"
                android:importantForAccessibility="no" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageView android:id="@+id/status_loading_title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minWidth="64dp" android:minHeight="10dp"
                    android:layout_marginStart="4.32dp" android:layout_gravity="start|center_vertical"
                    android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
            </FrameLayout>
            <ImageView android:id="@+id/status_loading_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="28dp" android:minHeight="8dp" android:layout_marginStart="4.32dp" android:layout_marginEnd="12dp"
                android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
            <!-- Same ID as the native card, so the refresh hit area keeps its action while loading. -->
            <LinearLayout android:id="@+id/status_refresh_hit" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_marginStart="6.84dp" android:paddingStart="3.6dp" android:paddingEnd="0dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:baselineAligned="false" android:contentDescription="@string/status_refresh">
                <ImageView android:id="@+id/status_loading_refresh" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minWidth="24dp" android:minHeight="8dp"
                    android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/status_refresh_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:maxWidth="12dp" android:maxHeight="12dp" android:adjustViewBounds="true" android:layout_marginStart="2.88dp"
                    android:src="@drawable/widget_refresh" android:tint="@color/widget_accent_dark" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/status_primary" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="63.15" android:layout_marginTop="5.76dp" android:layout_marginBottom="5.76dp"
            android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/status_sanity_primary" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="10.8dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:baselineAligned="false">
                <ImageView android:id="@+id/status_sanity_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:maxWidth="29.52dp" android:maxHeight="34.2dp" android:adjustViewBounds="true" android:layout_marginEnd="5.4dp"
                    android:scaleType="fitCenter" android:src="@drawable/widget_sanity_v2_dark" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView android:id="@+id/status_loading_sanity" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="44dp" android:minHeight="10dp"
                        android:layout_marginTop="3.5dp" android:layout_marginBottom="3.5dp"
                        android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                    <LinearLayout android:id="@+id/status_sanity_timer_row" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="3.24dp" android:orientation="horizontal"
                        android:gravity="center_vertical" android:baselineAligned="false">
                        <ImageView android:id="@+id/status_sanity_clock" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginEnd="2.88dp"
                            android:src="@drawable/widget_clock_dark" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/status_loading_sanity_time" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="30dp" android:minHeight="6.4dp"
                            android:layout_marginTop="2.4dp" android:layout_marginBottom="2.4dp"
                            android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/status_drone_primary" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="10.8dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:baselineAligned="false">
                <ImageView android:id="@+id/status_drone_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:maxWidth="29.52dp" android:maxHeight="34.2dp" android:adjustViewBounds="true" android:layout_marginEnd="5.4dp"
                    android:scaleType="fitCenter" android:src="@drawable/widget_drone_v2_dark" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView android:id="@+id/status_loading_drone" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="44dp" android:minHeight="10dp"
                        android:layout_marginTop="3.5dp" android:layout_marginBottom="3.5dp"
                        android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                    <LinearLayout android:id="@+id/status_drone_timer_row" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="3.24dp" android:orientation="horizontal"
                        android:gravity="center_vertical" android:baselineAligned="false">
                        <ImageView android:id="@+id/status_drone_clock" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginEnd="2.88dp"
                            android:src="@drawable/widget_clock_dark" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/status_loading_drone_time" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="30dp" android:minHeight="6.4dp"
                            android:layout_marginTop="2.4dp" android:layout_marginBottom="2.4dp"
                            android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/status_training_primary" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"
                android:baselineAligned="false">
                <ImageView android:id="@+id/status_loading_trainee" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minWidth="34.2dp" android:minHeight="34.2dp"
                    android:layout_marginEnd="5.4dp" android:background="@drawable/widget_placeholder_dark"
                    android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView android:id="@+id/status_loading_training" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="40dp" android:minHeight="8.4dp"
                        android:layout_marginTop="2.9dp" android:layout_marginBottom="2.9dp"
                        android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                    <LinearLayout android:id="@+id/status_training_timer_row" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="3.24dp" android:orientation="horizontal"
                        android:gravity="center_vertical" android:baselineAligned="false">
                        <ImageView android:id="@+id/status_training_clock" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginEnd="2.88dp"
                            android:src="@drawable/widget_clock_dark" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/status_loading_training_time" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="30dp" android:minHeight="6.4dp"
                            android:layout_marginTop="2.4dp" android:layout_marginBottom="2.4dp"
                            android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/status_summary" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="46.08" android:orientation="vertical" android:baselineAligned="false">
            <LinearLayout android:id="@+id/status_summary_row_first" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:id="@+id/status_recruit_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="5.76dp" android:paddingStart="3.6dp" android:paddingEnd="3.6dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
                    android:background="@drawable/widget_cell_dark">
                    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                        <ImageView android:id="@+id/status_loading_recruit_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="5.6dp"
                            android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <ImageView android:id="@+id/status_loading_recruit" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="12dp" android:minHeight="5.6dp"
                        android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/status_fatigue_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="5.76dp" android:paddingStart="3.6dp" android:paddingEnd="3.6dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
                    android:background="@drawable/widget_cell_dark">
                    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                        <ImageView android:id="@+id/status_loading_fatigue_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="5.6dp"
                            android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <ImageView android:id="@+id/status_loading_fatigue" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="12dp" android:minHeight="5.6dp"
                        android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/status_orders_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="5.76dp" android:paddingStart="3.6dp" android:paddingEnd="3.6dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
                    android:background="@drawable/widget_cell_dark">
                    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                        <ImageView android:id="@+id/status_loading_orders_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="5.6dp"
                            android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <ImageView android:id="@+id/status_loading_orders" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="12dp" android:minHeight="5.6dp"
                        android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/status_jade_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:orientation="vertical" android:baselineAligned="false">
                    <LinearLayout android:id="@+id/status_jade_info" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"
                        android:baselineAligned="false">
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <ImageView android:id="@+id/status_loading_jade_label" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:minWidth="20dp" android:minHeight="5.6dp"
                                android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <ImageView android:id="@+id/status_loading_jade" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="24dp" android:minHeight="5.6dp"
                            android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <ImageView android:id="@+id/status_jade_progress" android:layout_width="match_parent" android:layout_height="1.26dp"
                        android:layout_marginTop="1.98dp" android:background="@color/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/status_summary_row_second" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="4.32dp" android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout android:id="@+id/status_daily_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="5.76dp" android:paddingStart="3.6dp" android:paddingEnd="3.6dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
                    android:background="@drawable/widget_extra_dark">
                    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                        <ImageView android:id="@+id/status_loading_daily_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="5.6dp"
                            android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <ImageView android:id="@+id/status_loading_daily" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="12dp" android:minHeight="5.6dp"
                        android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/status_rest_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="5.76dp" android:paddingStart="3.6dp" android:paddingEnd="3.6dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
                    android:background="@drawable/widget_extra_dark">
                    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                        <ImageView android:id="@+id/status_loading_rest_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="5.6dp"
                            android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <ImageView android:id="@+id/status_loading_rest" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="12dp" android:minHeight="5.6dp"
                        android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/status_manufacture_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="5.76dp" android:paddingStart="3.6dp" android:paddingEnd="3.6dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
                    android:background="@drawable/widget_cell_dark">
                    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                        <ImageView android:id="@+id/status_loading_manufacture_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="5.6dp"
                            android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <ImageView android:id="@+id/status_loading_manufacture" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="12dp" android:minHeight="5.6dp"
                        android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/status_tower_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:orientation="vertical" android:baselineAligned="false">
                    <LinearLayout android:id="@+id/status_tower_info" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"
                        android:baselineAligned="false">
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <ImageView android:id="@+id/status_loading_tower_label" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:minWidth="20dp" android:minHeight="5.6dp"
                                android:layout_gravity="start|center_vertical" android:background="@drawable/widget_placeholder_dark"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <ImageView android:id="@+id/status_loading_tower" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="24dp" android:minHeight="5.6dp"
                            android:layout_marginStart="2.34dp" android:background="@drawable/widget_placeholder_dark"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <ImageView android:id="@+id/status_tower_progress" android:layout_width="match_parent" android:layout_height="1.26dp"
                        android:layout_marginTop="1.98dp" android:background="@color/widget_placeholder_dark"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
