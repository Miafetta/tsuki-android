<?xml version="1.0" encoding="utf-8"?>
<!-- The yellow of the Endfield band with the card's left corners, so the band is round even where the card is drawn in
     software (picker and app previews), where clipToOutline does not clip. The marks and the wordmark are drawn on it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_endfield_yellow" />
    <corners android:topLeftRadius="23.76dp" android:bottomLeftRadius="23.76dp" android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
