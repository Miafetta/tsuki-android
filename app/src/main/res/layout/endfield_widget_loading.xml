<?xml version="1.0" encoding="utf-8"?>
<!-- Shown from boot until the first render and while a new Endfield card waits for its first data: the static frame with translucent placeholder bars. Generated by gen_endfield_layouts.py. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background" android:forceDarkAllowed="false" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_endfield_surface" android:clipToOutline="true"
    android:contentDescription="@string/endfield_loading"
    tools:ignore="NestedWeights">
  <ImageView android:id="@+id/endfield_texture" android:layout_width="match_parent" android:layout_height="match_parent"
      android:src="@drawable/widget_endfield_bg_v3" android:scaleType="fitXY" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/endfield_content" android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="horizontal" android:baselineAligned="false">
    <FrameLayout android:id="@+id/endfield_band_frame" android:layout_width="wrap_content" android:layout_height="match_parent">
      <ImageView android:id="@+id/endfield_band" android:layout_width="28dp" android:layout_height="match_parent"
          android:background="@drawable/widget_endfield_band_shape" android:importantForAccessibility="no" />
      <ImageView android:id="@+id/endfield_band_hatch" android:layout_width="28dp" android:layout_height="match_parent"
          android:src="@drawable/widget_endfield_band_hatch" android:scaleType="fitXY" android:importantForAccessibility="no" />
      <ImageView android:id="@+id/endfield_band_marks" android:layout_width="5dp" android:layout_height="31.3dp"
          android:layout_gravity="top|end" android:layout_marginTop="5dp" android:layout_marginEnd="4dp"
          android:src="@drawable/widget_endfield_band_marks_v2" android:scaleType="fitCenter" android:importantForAccessibility="no" />
      <ImageView android:id="@+id/endfield_band_word" android:layout_width="16dp" android:layout_height="78dp"
          android:layout_gravity="bottom|end" android:layout_marginBottom="9.5dp" android:layout_marginEnd="4dp"
          android:src="@drawable/widget_endfield_band_word_v2" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/endfield_main" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="9.5dp" android:paddingEnd="9.5dp" android:paddingTop="0dp"
        android:paddingBottom="9.5dp">
      <LinearLayout android:id="@+id/status_header" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="24.5" android:gravity="center_vertical"
          android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/endfield_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
          <ImageView android:id="@+id/endfield_brand_mark" android:layout_width="83dp" android:layout_height="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_endfield_brand_v2" android:importantForAccessibility="no" />
        </LinearLayout>
        <FrameLayout android:id="@+id/endfield_header_space" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" />
        <LinearLayout android:id="@+id/status_refresh_hit" android:contentDescription="@string/status_refresh" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="8dp"
            android:paddingEnd="0dp" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false"
            tools:ignore="UseCompoundDrawables">
          <ImageView android:id="@+id/status_refresh_arrow" android:layout_width="11.5dp" android:layout_height="11.5dp"
              android:src="@drawable/widget_endfield_refresh_v3" android:importantForAccessibility="no" />
          <ImageView android:id="@+id/endfield_loading_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="22dp" android:minHeight="8dp" android:layout_marginStart="2.8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/endfield_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="127.8"
          android:orientation="horizontal" android:baselineAligned="false">
        <FrameLayout android:id="@+id/status_sanity_primary" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="0.77" android:layout_marginEnd="6dp" android:background="@drawable/widget_endfield_panel">
          <ImageView android:id="@+id/status_sanity_icon" android:layout_width="53dp" android:layout_height="56dp" android:layout_gravity="top|end"
              android:layout_marginTop="2dp" android:scaleType="fitCenter" android:src="@drawable/widget_endfield_sanity_v2"
              android:importantForAccessibility="no" />
          <LinearLayout android:id="@+id/endfield_sanity_info" android:layout_width="match_parent" android:layout_height="match_parent"
              android:orientation="vertical" android:paddingStart="9.5dp" android:paddingEnd="7dp" android:paddingTop="9.5dp"
              android:paddingBottom="9.5dp">
            <ImageView android:id="@+id/endfield_loading_sanity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="52dp" android:minHeight="14dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/endfield_loading_sanity_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="26dp" android:minHeight="9dp" android:layout_marginTop="4dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/endfield_sanity_space" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageView android:id="@+id/endfield_loading_recovery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="40dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/status_sanity_timer_row" android:layout_width="wrap_content" android:layout_height="19dp"
                android:layout_marginTop="3dp" android:paddingStart="7.5dp" android:paddingEnd="9.5dp" android:gravity="center_vertical"
                android:background="@drawable/widget_endfield_pill" android:orientation="horizontal" android:baselineAligned="false"
                tools:ignore="UseCompoundDrawables">
              <ImageView android:id="@+id/status_sanity_clock" android:layout_width="4dp" android:layout_height="4dp"
                  android:layout_marginEnd="4dp" android:src="@drawable/widget_endfield_dot_green" android:importantForAccessibility="no" />
              <ImageView android:id="@+id/endfield_loading_sanity_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:minHeight="7dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
            </LinearLayout>
          </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/endfield_rows_frame" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.23" android:background="@drawable/widget_endfield_panel">
          <ImageView android:id="@+id/endfield_panel_mark" android:layout_width="120dp" android:layout_height="96dp"
              android:layout_gravity="bottom|end" android:src="@drawable/widget_endfield_panel_mark_v2"
              android:scaleType="fitXY" android:importantForAccessibility="no" />
          <LinearLayout android:id="@+id/endfield_rows" android:layout_width="match_parent" android:layout_height="match_parent"
              android:orientation="vertical" android:paddingStart="9.5dp" android:paddingEnd="9.5dp" android:paddingTop="2.5dp"
              android:paddingBottom="2.5dp">
            <FrameLayout android:id="@+id/endfield_daily_cell" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">
              <ImageView android:id="@+id/endfield_daily_dots" android:layout_width="38dp" android:layout_height="19dp"
                  android:layout_gravity="top|start" android:layout_marginStart="24dp"
                  android:src="@drawable/widget_endfield_item_dot" android:scaleType="fitXY" android:importantForAccessibility="no" />
              <LinearLayout android:id="@+id/endfield_daily_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_gravity="center_vertical" android:orientation="horizontal" android:gravity="center_vertical"
                  android:baselineAligned="false">
                <ImageView android:id="@+id/endfield_daily_icon" android:layout_width="15dp" android:layout_height="15dp"
                    android:layout_marginEnd="5.8dp" android:scaleType="fitCenter"
                    android:src="@drawable/widget_endfield_daily_v2" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_daily_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="44dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_daily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
              </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/endfield_divider_1" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_endfield_divider" android:orientation="vertical" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/endfield_weekly_cell" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">
              <ImageView android:id="@+id/endfield_weekly_dots" android:layout_width="38dp" android:layout_height="19dp"
                  android:layout_gravity="top|start" android:layout_marginStart="24dp"
                  android:src="@drawable/widget_endfield_item_dot" android:scaleType="fitXY" android:importantForAccessibility="no" />
              <LinearLayout android:id="@+id/endfield_weekly_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_gravity="center_vertical" android:orientation="horizontal" android:gravity="center_vertical"
                  android:baselineAligned="false">
                <ImageView android:id="@+id/endfield_weekly_icon" android:layout_width="15dp" android:layout_height="15dp"
                    android:layout_marginEnd="5.8dp" android:scaleType="fitCenter"
                    android:src="@drawable/widget_endfield_weekly_v2" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_weekly_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="44dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_weekly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
              </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/endfield_divider_2" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_endfield_divider" android:orientation="vertical" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/endfield_pass_cell" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">
              <ImageView android:id="@+id/endfield_pass_dots" android:layout_width="38dp" android:layout_height="19dp"
                  android:layout_gravity="top|start" android:layout_marginStart="24dp"
                  android:src="@drawable/widget_endfield_item_dot" android:scaleType="fitXY" android:importantForAccessibility="no" />
              <LinearLayout android:id="@+id/endfield_pass_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_gravity="center_vertical" android:orientation="horizontal" android:gravity="center_vertical"
                  android:baselineAligned="false">
                <ImageView android:id="@+id/endfield_pass_icon" android:layout_width="15dp" android:layout_height="15dp"
                    android:layout_marginEnd="5.8dp" android:scaleType="fitCenter"
                    android:src="@drawable/widget_endfield_pass_v2" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_pass_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="44dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_pass" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
              </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/endfield_divider_3" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_endfield_divider" android:orientation="vertical" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/endfield_seek_cell" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">
              <ImageView android:id="@+id/endfield_seek_dots" android:layout_width="38dp" android:layout_height="19dp"
                  android:layout_gravity="top|start" android:layout_marginStart="24dp"
                  android:src="@drawable/widget_endfield_item_dot" android:scaleType="fitXY" android:importantForAccessibility="no" />
              <LinearLayout android:id="@+id/endfield_seek_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                  android:layout_gravity="center_vertical" android:orientation="horizontal" android:gravity="center_vertical"
                  android:baselineAligned="false">
                <ImageView android:id="@+id/endfield_seek_icon" android:layout_width="15dp" android:layout_height="15dp"
                    android:layout_marginEnd="5.8dp" android:scaleType="fitCenter"
                    android:src="@drawable/widget_endfield_seek" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_seek_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="44dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
                <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/endfield_loading_seek" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="8dp" android:background="@drawable/widget_placeholder_dark" android:importantForAccessibility="no" />
              </LinearLayout>
            </FrameLayout>
          </LinearLayout>
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/endfield_stripe" android:layout_width="wrap_content" android:layout_height="2.5dp"
      android:layout_gravity="bottom|end" android:layout_marginEnd="24dp" android:orientation="horizontal"
      android:importantForAccessibility="no">
    <LinearLayout android:id="@+id/endfield_stripe_magenta" android:layout_width="16dp" android:layout_height="match_parent" android:background="@color/widget_endfield_magenta" android:orientation="vertical" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/endfield_stripe_yellow" android:layout_width="16dp" android:layout_height="match_parent" android:background="@color/widget_endfield_yellow" android:orientation="vertical" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/endfield_stripe_cyan" android:layout_width="16dp" android:layout_height="match_parent" android:background="@color/widget_endfield_cyan" android:orientation="vertical" android:importantForAccessibility="no" />
  </LinearLayout>
</FrameLayout>
