<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-in for a text value or the training portrait. GradientDrawable clamps the radius to half the height,
     so the short text bars become pills while the portrait keeps the 3.6dp corners of the real one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_placeholder_dark" />
    <corners android:radius="3.6dp" />
</shape>
