<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tsuki" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3482FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F7F7F7</item>
    </style>
    <style name="WidgetSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">@dimen/miuix_widget_body2</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/widget_text_dark</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetLabel" parent="WidgetSummary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/miuix_widget_footnote1</item>
    </style>
    <style name="WidgetTitle" parent="WidgetSummary">
        <item name="android:textSize">@dimen/miuix_widget_title2</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetAmount" parent="WidgetSummary">
        <item name="android:textSize">@dimen/miuix_widget_title2</item>
    </style>
    <style name="WidgetTraining" parent="WidgetAmount">
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">@dimen/miuix_widget_title3</item>
    </style>
    <style name="WidgetTimer" parent="WidgetSummary">
        <item name="android:textSize">@dimen/miuix_widget_body1</item>
        <item name="android:drawablePadding">2.88dp</item>
    </style>
    <style name="WidgetRefresh" parent="WidgetSummary">
        <item name="android:textSize">@dimen/widget_header_text</item>
    </style>
    <style name="WidgetRefreshTime" parent="WidgetRefresh" />
    <style name="WidgetValue" parent="WidgetSummary" />
    <!-- Endfield card text, sized like the official widget (widget_endfield_dimens.xml); fixed dp like the other widget text. -->
    <style name="WidgetEndfield" parent="WidgetSummary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="WidgetEndfield.Brand"><item name="android:textSize">@dimen/widget_endfield_brand</item></style>
    <style name="WidgetEndfield.Amount">
        <item name="android:textSize">@dimen/widget_endfield_amount</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
    </style>
    <style name="WidgetEndfield.AmountMax">
        <item name="android:textSize">@dimen/widget_endfield_amount_max</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="WidgetEndfield.SanityLabel"><item name="android:textSize">@dimen/widget_endfield_sanity_label</item></style>
    <style name="WidgetEndfield.Caption"><item name="android:textSize">@dimen/widget_endfield_caption</item></style>
    <style name="WidgetEndfield.Pill"><item name="android:textSize">@dimen/widget_endfield_pill</item></style>
    <style name="WidgetEndfield.Row"><item name="android:textSize">@dimen/widget_endfield_row</item></style>
    <style name="WidgetEndfield.Value">
        <item name="android:textSize">@dimen/widget_endfield_value</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:fontFeatureSettings">tnum, lnum</item>
    </style>
</resources>
