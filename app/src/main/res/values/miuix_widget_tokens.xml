    <color name="miuix_widget_on_surface_light">#FF000000</color>
    <color name="miuix_widget_summary_light">#99000000</color>
    <color name="miuix_widget_surface_light">#FFF7F7F7</color>
    <color name="miuix_widget_container_light">#FFFFFFFF</color>
    <color name="miuix_widget_primary_light">#FF3482FF</color>
