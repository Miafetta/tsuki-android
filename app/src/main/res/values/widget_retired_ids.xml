<?xml version="1.0" encoding="utf-8"?>
<!-- View IDs no longer in any widget layout. They stay declared so their pinned numbers (widget-resource-ids.txt) are never
     reused: a host may still apply cached actions for them, which find no view and are skipped. -->
<resources>
    <!-- The Endfield header marks were texts until the header became one image (endfield_brand_mark). -->
    <item name="endfield_brand_platform" type="id" />
    <item name="endfield_brand_game" type="id" />
    <item name="endfield_brand_divider" type="id" />
    <!-- Endfield row progress bars were retired when aligning to the official 4-row Android widget. -->
    <item name="endfield_daily_progress" type="id" />
    <item name="endfield_daily_fill" type="id" />
    <item name="endfield_weekly_progress" type="id" />
    <item name="endfield_weekly_fill" type="id" />
    <item name="endfield_pass_progress" type="id" />
    <item name="endfield_pass_fill" type="id" />
</resources>
