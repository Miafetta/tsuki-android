<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">
    <TextView
        android:id="@+id/probe_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/probe_placeholder"
        android:textColor="#FFF4EDE3"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/probe_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/probe_waiting"
        android:textColor="#FFDDC9AC"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/probe_refresh"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="@string/refresh"
        android:textColor="#FFF4EDE3"
        android:textSize="14sp" />
</LinearLayout>
