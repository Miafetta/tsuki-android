<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Tsuki">
        <meta-data android:name="miuiWidgetVersion" android:value="56" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SklandAccountActivity" android:exported="false" />
        <service android:name=".widget.WidgetRefreshJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" android:process=":widgetProvider" />
        <service android:name=".widget.ReminderJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" android:process=":widgetProvider" />
        <activity android:name=".WidgetConfigActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tsuki" android:host="configure" />
            </intent-filter>
        </activity>
        <provider
            android:name=".widget.WidgetStorageProvider"
            android:authorities="cafe.miafetta.tsuki.widgets"
            android:exported="false"
            android:process=":widgetProvider" />
        <receiver android:name=".widget.PinWidgetReceiver" android:exported="false" />
        <receiver
            android:name=".widget.StatusWidgetProvider"
            android:exported="true"
            android:label="@string/status_widget_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/status_widget_info" />
            <meta-data android:name="supportBackgroundBlur" android:value="true" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="20000" />
        </receiver>
        <receiver
            android:name=".widget.OpaqueWidgetProvider"
            android:exported="true"
            android:label="@string/status_widget_dark_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/status_widget_dark_info" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="20000" />
        </receiver>
        <receiver
            android:name=".widget.EndfieldWidgetProvider"
            android:exported="true"
            android:label="@string/endfield_widget_name"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/endfield_widget_info" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="20000" />
        </receiver>
        <receiver
            android:name=".widget.XiaomiProbeProvider"
            android:enabled="${debugToolsEnabled}"
            android:exported="true"
            android:label="@string/probe_xiaomi"
            android:process=":widgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/probe_widget_info" />
            <meta-data android:name="miuiWidget" android:value="true" />
            <meta-data android:name="miuiWidgetRefresh" android:value="exposure" />
            <meta-data android:name="miuiWidgetRefreshMinInterval" android:value="20000" />
        </receiver>
    </application>
</manifest>
